APP_NAME="Rosa Acevedo · Itagüí 2027"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# MySQL de Hostinger en producción (DB_HOST=localhost). En local, MariaDB 10.11 (Docker Compose).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rosa
DB_USERNAME=rosa
DB_PASSWORD=rosa

# Hosting compartido sin Redis: cola, caché y sesiones en la base de datos.
SESSION_DRIVER=database
# Sesión del panel: expira a los 30 minutos sin actividad (sección 03).
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=rosa

# Caché de páginas públicas completas (spatie/laravel-responsecache).
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_DRIVER=file

# Correo transaccional por Brevo (SPF, DKIM y DMARC en el dominio).
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-responder@rosaacevedo.com"
MAIL_FROM_NAME="Rosa Acevedo"

# Clave del HMAC del celular (deduplicación). Generar con: php -r "echo bin2hex(random_bytes(32));"
# No cambiarla nunca en producción: cambiarla rompe la deduplicación.
CELULAR_HMAC_KEY=

# CRM de la campaña. «nulo» deja el outbox pendiente hasta tener el contrato de la API.
CRM_DRIVER=nulo
CRM_URL=
CRM_SECRETO=
CRM_ALERTA_EMAIL=

# Cloudflare Turnstile (sin secreto no se exige: solo para local).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Umami autoalojado, sin cookies.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_DOMINIOS=rosaacevedo.com

# Doble factor obligatorio en el panel. Solo se apaga en local.
DOS_FACTORES=false

# Entorno de pruebas (pruebas.rosaacevedo.com): contraseña básica y noindex.
PRUEBAS_USUARIO=
PRUEBAS_CLAVE=

# Clasificación asistida de propuestas (fase 2).
ANTHROPIC_API_KEY=

# Copias de seguridad fuera de Hostinger (spatie/laravel-backup).
BACKUP_DISCO=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICAR_A=

VITE_APP_NAME="${APP_NAME}"
